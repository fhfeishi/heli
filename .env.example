# heli 本地配置模板：复制为 .env 后按需修改（cp .env.example .env）
#
# .knowledge/<库>/ 内含：
#   source/   原始文件（PDF / Markdown）
#   parsed/   解析产物（markdown.md、middle_json.json、images/）
#   target/   按 task schema 从原文提取的结果（<doc_id>.json）
#   datadb/   kb.db（来源、章节、版本、分块、任务）
#   vectordb/ 向量与全文索引

# 资料库根。Windows 写法与 WSL 写法都收，代码按运行环境自动换算：
#   e:/local_db/.knowledge      Windows 内原样用；WSL 内换成 /mnt/e/local_db/.knowledge
#   /mnt/e/local_db/.knowledge  WSL 内原样用；Windows 内换成 E:/local_db/.knowledge
KNOWLEDGE_ROOT=e:/local_db/.knowledge

# 应用数据根：heli.db、原件副本、成果都放这里（不是资料库根）。
# 缺省是 <项目根>/heli-data；建议放在资料库根下的内部目录，便于和资料库一起备份。
HELI_DATA=e:/local_db/.knowledge/.heli

# 可选：本地 embedding 模型根目录（跑 v2-update 建语义索引时才需要，不联网下载）
# HELI_EMBEDDING_ROOT=/mnt/e/local_models/embedding
# HELI_EMBEDDING_DEVICE=cpu

# 可选：页面端口（launch.sh 用，默认 8011）
# PORT=8011


DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=